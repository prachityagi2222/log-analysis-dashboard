{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Log Analysis Dashboard",
  "mainBinaryName": "log-analysis-dashboard",
  "version": "1.0.0",
  "identifier": "com.logdashboard.desktop",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/log-backend"
    ],
    "category": "Utility",
    "shortDescription": "Local-first AI-powered log investigation dashboard",
    "longDescription": "Analyze SSH, web server and firewall logs entirely on your machine and get plain-English security reports mapped to MITRE ATT&CK tactics.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}